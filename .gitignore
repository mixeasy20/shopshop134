# .gitignore
# Ignore OS files
.DS_Store
Thumbs.db

# Ignore local config (optional, if you want to keep your DB password secret)
# config.php

# Ignore uploads (so your local test photos don't go to GitHub)
uploads/*
!uploads/.gitkeep

# Ignore Node/Firebase leftovers
node_modules/
package-lock.json
firebase-init.js
auth.js
firebase.js
